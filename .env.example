# System Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change_this_to_a_secure_random_key

# Anthropic / Claude Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
DEFAULT_CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Microsoft 365 / Azure AD Credentials
MS_GRAPH_CLIENT_ID=your_azure_client_id
MS_GRAPH_CLIENT_SECRET=your_azure_client_secret
MS_GRAPH_TENANT_ID=your_azure_tenant_id
MS_GRAPH_SHAREPOINT_SITE_ID=your_sharepoint_site_id

# TrekkSoft API Configuration
TREKKSOFT_API_URL=https://api.trekksoft.com/v1
TREKKSOFT_API_KEY=your_trekksoft_api_key
TREKKSOFT_MERCHANT_ID=your_merchant_id

# bexio API Configuration
BEXIO_API_URL=https://api.bexio.com/2.0
BEXIO_API_TOKEN=your_bexio_api_token

# Brevo (Sendinblue) API Configuration
BREVO_API_URL=https://api.brevo.com/v3
BREVO_API_KEY=your_brevo_api_key

# Vector Database / RAG Configuration
CHROMA_PERSIST_DIR=./data/chroma_db
